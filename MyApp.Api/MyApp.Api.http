Content-Type: application/json

{
  "orderNumber": "ORD-1001",
  "orderDate": "2026-10-04T10:00:00Z",
  "customerId": 1,
  "description": "Updated",
  "status": "Processing",
  "items": [
    {
      "id": 1,
      "productId": 1,
      "quantity": 3
    }
  ]
}

###

DELETE {{MyApp.Api_HostAddress}}/api/orders/1

###

